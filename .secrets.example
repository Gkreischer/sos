# ============================================================
# SOS Application - Secrets Configuration
# ============================================================
# Copy this file to .secrets and fill in your actual values
# NEVER commit .secrets to version control!
# ============================================================

# ============================================================
# DOCKER REGISTRY
# ============================================================
# Docker Hub credentials (for pushing images to Docker Hub)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token

# GitHub Container Registry (GHCR) - uses GITHUB_TOKEN automatically
# No additional config needed for GHCR

# ============================================================
# STAGING ENVIRONMENT
# ============================================================
# SSH connection to staging server
STAGING_HOST=staging.yourdomain.com
STAGING_USER=deploy
STAGING_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END OPENSSH PRIVATE KEY-----"
STAGING_PORT=22
STAGING_URL=https://staging.yourdomain.com

# Staging database
STAGING_DB_PASSWORD=staging-secure-db-password

# Staging Reverb (WebSocket)
STAGING_REVERB_APP_ID=123456
STAGING_REVERB_APP_KEY=staging-reverb-app-key
STAGING_REVERB_APP_SECRET=staging-reverb-app-secret

# Staging Laravel
STAGING_APP_KEY=base64:staging-app-key-here
STAGING_APP_VERSION=1.0.0-staging

# ============================================================
# PRODUCTION ENVIRONMENT
# ============================================================
# SSH connection to production server
PRODUCTION_HOST=yourdomain.com
PRODUCTION_USER=deploy
PRODUCTION_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END OPENSSH PRIVATE KEY-----"
PRODUCTION_PORT=22
PRODUCTION_URL=https://yourdomain.com

# Production database
PRODUCTION_DB_PASSWORD=production-secure-db-password

# Production Reverb (WebSocket)
PRODUCTION_REVERB_APP_ID=123456
PRODUCTION_REVERB_APP_KEY=production-reverb-app-key
PRODUCTION_REVERB_APP_SECRET=production-reverb-app-secret

# Production Laravel
PRODUCTION_APP_KEY=base64:production-app-key-here
PRODUCTION_APP_VERSION=1.0.0

# ============================================================
# NOTIFICATIONS & EXTERNAL SERVICES
# ============================================================
# Slack webhook for deployment notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/XXX/XXX

# Codecov for coverage reporting
CODECOV_TOKEN=your-codecov-token

# ============================================================
# LOCAL DEVELOPMENT / ACT TESTING
# ============================================================
# These are used when running CI locally with 'act'
# They can be less secure / test values

# Local Docker (act uses host docker)
ACT_DOCKER_HOST=unix:///var/run/docker.sock

# Local database for act testing
ACT_DB_PASSWORD=act-test-password
ACT_REVERB_APP_ID=999999
ACT_REVERB_APP_KEY=act-test-key
ACT_REVERB_APP_SECRET=act-test-secret

# Local app key for testing
ACT_APP_KEY=base64:act-test-app-key-32chars-long!!
ACT_APP_VERSION=1.0.0-test

# Fake SSH for act (act doesn't really SSH, but workflow expects these)
ACT_STAGING_HOST=localhost
ACT_STAGING_USER=act
ACT_STAGING_PORT=2222
ACT_PRODUCTION_HOST=localhost
ACT_PRODUCTION_USER=act
ACT_PRODUCTION_PORT=2222

# ============================================================
# OPTIONAL: CLOUD PROVIDERS (for future use)
# ============================================================
# AWS
# AWS_ROLE_ARN=arn:aws:iam::123456789:role/GitHubActions
# AWS_WEB_IDENTITY_TOKEN_FILE=/tmp/aws-creds

# GCP
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123/locations/global/workloadIdentityPools/my-pool/providers/my-provider
# GCP_SERVICE_ACCOUNT_EMAIL=github-actions@my-project.iam.gserviceaccount.com

# Azure
# AZURE_CLIENT_ID=xxx
# AZURE_TENANT_ID=xxx
# AZURE_SUBSCRIPTION_ID=xxx