# ============================================================
# SOS All-in-One Dockerfile
# Builds: Frontend (Angular/Ionic), Backend (Laravel), Redis, PostgreSQL
# Runs all services via supervisord in a single container
# ============================================================
#
# PERSISTENT VOLUMES:
# - /var/lib/postgresql/15/main  -> PostgreSQL database data
# - /var/lib/redis               -> Redis data (RDB snapshots)
#
# To persist data across container restarts, mount these volumes:
#   docker run -v sos-postgres:/var/lib/postgresql/15/main -v sos-redis:/var/lib/redis ...
# Or with docker-compose:
#   volumes:
#     - postgres_data:/var/lib/postgresql/15/main
#     - redis_data:/var/lib/redis

# ============================================================
# STAGE 1: Frontend Build (Angular/Ionic)
# ============================================================
FROM docker.io/library/node:22-alpine AS frontend-builder

WORKDIR /app

# Copy frontend package files
COPY sos_app/package*.json ./
COPY sos_app/capacitor-barcode-scanner-3.1.0.tgz ./

# Install dependencies
RUN npm ci

# Copy frontend source
COPY sos_app/ ./

# Build production frontend (both main app and ticket-support)
RUN npm run build:all


# ============================================================
# STAGE 2: Backend Build (Laravel)
# ============================================================
FROM docker.io/shinsenter/laravel:php8.5-alpine AS backend-builder

WORKDIR /var/www/html

# Copy composer files
COPY sos_api/composer.json sos_api/composer.lock ./

# Install PHP dependencies (production only)
RUN composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction

# Copy backend source
COPY sos_api ./

# Copy env example and create .env
RUN cp .env.example .env

# Clear caches after copy
RUN rm -f bootstrap/cache/*.php

# Clear config caches
RUN rm -f bootstrap/cache/config.php \
    bootstrap/cache/routes-v7.php \
    bootstrap/cache/services.php \
    bootstrap/cache/packages.php

# Create storage directories
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs

# Set permissions
RUN chown -R www-data:www-data /var/www/html


# ============================================================
# STAGE 3: Final Runtime Image
# ============================================================
FROM docker.io/library/debian:bookworm-slim AS runtime

# Install system dependencies
# Note: Laravel requires PHP 8.5+, so we add the sury repository
RUN apt-get update && apt-get install -y --no-install-recommends \
    lsb-release \
    ca-certificates \
    apt-transport-https \
    gnupg \
    curl \
    && curl -sSLo /usr/share/keyrings/deb.sury.org-php.gpg https://packages.sury.org/php/apt.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/deb.sury.org-php.gpg] https://packages.sury.org/php/ $(lsb_release -sc) main" > /etc/apt/sources.list.d/php.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    # PHP 8.5 & extensions
    php8.5 \
    php8.5-fpm \
    php8.5-cli \
    php8.5-pgsql \
    php8.5-redis \
    php8.5-mbstring \
    php8.5-xml \
    php8.5-curl \
    php8.5-zip \
    php8.5-gd \
    php8.5-bcmath \
    php8.5-intl \
    # php8.5-opcache is built into PHP core, not a separate package
    # php8.5-pcntl is built into PHP core, not a separate package
    # Nginx
    nginx \
    # PostgreSQL (bookworm has postgresql-15)
    postgresql-15 \
    postgresql-client-15 \
    # Redis
    redis-server \
    # Supervisord for process management
    supervisor \
    # Clean up
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================
# Configure PHP-FPM
# ============================================================
RUN mkdir -p /run/php

# PHP-FPM pool config - listen on 9000 (internal)
RUN echo "[www]\n\
user = www-data\n\
group = www-data\n\
listen = 9000\n\
listen.owner = www-data\n\
listen.group = www-data\n\
listen.allowed_clients = 127.0.0.1\n\
pm = dynamic\n\
pm.max_children = 50\n\
pm.start_servers = 5\n\
pm.min_spare_servers = 5\n\
pm.max_spare_servers = 35\n\
pm.max_requests = 500\n\
request_terminate_timeout = 300\n\
catch_workers_output = yes\n\
php_admin_value[error_log] = /var/log/php-fpm/error.log\n\
php_admin_flag[log_errors] = on\n\
php_admin_value[memory_limit] = 256M\n\
" > /etc/php/8.5/fpm/pool.d/www.conf

# PHP-FPM main config - include pool configs
RUN echo "[global]\n\
pid = /run/php/php8.5-fpm.pid\n\
error_log = /var/log/php-fpm/error.log\n\
daemonize = no\n\
include = /etc/php/8.5/fpm/pool.d/*.conf\n\
" > /etc/php/8.5/fpm/php-fpm.conf

# Ensure run directory exists at runtime
RUN mkdir -p /run/php && chown www-data:www-data /run/php

# PHP ini tweaks
RUN echo "memory_limit = 256M\n\
upload_max_filesize = 100M\n\
post_max_size = 100M\n\
max_execution_time = 300\n\
date.timezone = UTC\n\
opcache.enable = 1\n\
opcache.memory_consumption = 128\n\
opcache.interned_strings_buffer = 8\n\
opcache.max_accelerated_files = 10000\n\
opcache.revalidate_freq = 2\n\
opcache.fast_shutdown = 1\n\
" > /etc/php/8.5/fpm/conf.d/99-sos.ini


# ============================================================
# Configure Nginx
# ============================================================
# Remove default nginx config
RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default

# Copy nginx config from project (adapted for single-container)
COPY docker/nginx/default-all-in-one.conf /etc/nginx/conf.d/default.conf

# Create nginx log dir
RUN mkdir -p /var/log/nginx


# ============================================================
# Configure PostgreSQL
# ============================================================
# PostgreSQL data directory
RUN mkdir -p /var/lib/postgresql/15/main \
    && chown -R postgres:postgres /var/lib/postgresql/15/main \
    && chmod 700 /var/lib/postgresql/15/main

# Define volume for PostgreSQL data persistence
# This ensures database data survives container restarts/recreates
VOLUME ["/var/lib/postgresql/15/main"]

# PostgreSQL config - allow local connections without password for superuser
RUN echo "local   all             postgres                                trust\n\
local   all             all                                     md5\n\
host    all             all             127.0.0.1/32            md5\n\
host    all             all             ::1/128                 md5\n\
" > /etc/postgresql/15/main/pg_hba.conf

# Create pg_ident.conf
RUN echo "# MAPNAME       SYSTEM-USERNAME         PG-USERNAME\n\
" > /etc/postgresql/15/main/pg_ident.conf

# Create run directory for PostgreSQL
RUN mkdir -p /var/run/postgresql && chown postgres:postgres /var/run/postgresql

# PostgreSQL main config - listen on localhost only
RUN echo "listen_addresses = 'localhost'\n\
port = 5432\n\
max_connections = 100\n\
shared_buffers = 128MB\n\
effective_cache_size = 512MB\n\
maintenance_work_mem = 64MB\n\
checkpoint_completion_target = 0.9\n\
wal_buffers = 16MB\n\
default_statistics_target = 100\n\
random_page_cost = 1.1\n\
effective_io_concurrency = 200\n\
work_mem = 4MB\n\
min_wal_size = 1GB\n\
max_wal_size = 4GB\n\
hba_file = '/etc/postgresql/15/main/pg_hba.conf'\n\
ident_file = '/etc/postgresql/15/main/pg_ident.conf'\n\
external_pid_file = '/var/run/postgresql/15-main.pid'\n\
unix_socket_directories = '/var/run/postgresql'\n\
" > /etc/postgresql/15/main/postgresql.conf


# ============================================================
# Configure Redis
# ============================================================

RUN mkdir -p /var/lib/redis \
    && chown -R redis:redis /var/lib/redis \
    && chmod 750 /var/lib/redis \
    && echo "bind 127.0.0.1\n\
port 6379\n\
timeout 0\n\
tcp-keepalive 300\n\
databases 16\n\
dir /var/lib/redis\n\
dbfilename dump.rdb\n\
save 900 1\n\
save 300 10\n\
save 60 10000\n\
maxmemory 256mb\n\
maxmemory-policy allkeys-lru\n\
" > /etc/redis/redis.conf

# Define volume for Redis data persistence
# This ensures Redis data survives container restarts/recreates
VOLUME ["/var/lib/redis"]


# ============================================================
# Copy Built Artifacts
# ============================================================
# Copy backend (Laravel)
COPY --from=backend-builder /var/www/html /var/www/html

# Enable artisan for CLI
RUN ln -s /var/www/html/artisan /usr/local/bin/artisan

RUN chown -R www-data:www-data /var/www/html

# Copy frontend build output (Angular/Ionic)
COPY --from=frontend-builder /app/www/browser /usr/share/nginx/html
COPY --from=frontend-builder /app/dist/ticket-support/browser /usr/share/nginx/html/ticket-support
RUN chown -R www-data:www-data /usr/share/nginx/html


# ============================================================
# Configure Supervisord
# ============================================================
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create log directories
RUN mkdir -p /var/log/supervisor /var/log/php-fpm \
    && chown postgres:postgres /var/log/supervisor \
    && chown redis:redis /var/log/supervisor \
    && chown www-data:www-data /var/log/php-fpm


# ============================================================
# Entrypoint Script
# ============================================================
COPY docker/entrypoint-all-in-one.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh


# ============================================================
# Expose Ports
# ============================================================
# 80: Nginx (HTTP)
# 443: Nginx (HTTPS) - requires SSL certs
# 5432: PostgreSQL (internal only - not exposed externally)
# 6379: Redis (internal only - not exposed externally)
# 8080: Laravel Reverb/WebSocket (proxied by nginx)
EXPOSE 80 443


# ============================================================
# Health Check
# ============================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/health || exit 1


# ============================================================
# Run Supervisord
# ============================================================
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
