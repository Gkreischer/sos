# Environment variables for the SOS application
# Copy this file to .env and change the values

APP_NAME=SOSDB
APP_ENV=production
APP_KEY=base64:+HQwP/2t5u0SYb7W9pXkuuj2tsDFNsJx+DpP/8PVVTY=

APP_DEBUG=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=sos
DB_USERNAME=sos
DB_PASSWORD=CHANGEYOURPASSWORD

CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb

REVERB_APP_ID=432064
REVERB_APP_KEY=GENERATEYOUROWNKEY
REVERB_APP_SECRET=GENERATEYOUROWNSECRET

REDIS_HOST=redis
REDIS_PORT=6379

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

LARAVEL_ENABLE_QUEUE_WORKER=1
LARAVEL_ENABLE_SCHEDULER=1
LARAVEL_ENABLE_REVERB=1

