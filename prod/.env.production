# SOS Production Environment Configuration
# Copy this file to .env and fill in your production values
# NEVER commit this file with real secrets!

# ============================================================
# Application
# ============================================================
APP_NAME=SOSDB
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_VERSION=1.0.0

# ============================================================
# Logging
# ============================================================
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ============================================================
# Database (PostgreSQL)
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sos
DB_USERNAME=sos
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ============================================================
# Cache & Session (Redis)
# ============================================================
CACHE_DRIVER=redis
CACHE_PREFIX=sos_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=default

# ============================================================
# Queue (Redis)
# ============================================================
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# ============================================================
# Redis
# ============================================================
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CLIENT=phpredis

# ============================================================
# Filesystem
# ============================================================
FILESYSTEM_DISK=local

# ============================================================
# Broadcasting (Reverb)
# ============================================================
BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb

REVERB_APP_ID=432064
REVERB_APP_KEY=CHANGE_ME_REVERB_APP_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_APP_SECRET

REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ============================================================
# Laravel Octane / Workers (using built-in queue worker, scheduler, reverb)
# ============================================================
LARAVEL_ENABLE_QUEUE_WORKER=1
LARAVEL_ENABLE_SCHEDULER=1
LARAVEL_ENABLE_REVERB=1

# ============================================================
# Mail (configure for production)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Other Services (configure as needed)
# ============================================================
# AWS/Azure/GCS for file storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Sentry for error tracking
# SENTRY_LARAVEL_DSN=